# ============================================================
# Root .gitignore — Stargazing & Milky Way Forecast Monorepo
# Covers Backend (FastAPI), Frontend (Next.js), Docker & Secrets
# ============================================================

# ============================================================
# 1. SECRETS, CREDENTIALS & ENVIRONMENT FILES (STRICT)
# ============================================================
# Ignore all variations of .env files and un-dotted env files
.env
.env.*
*.env
*.env.*
env
env.*
!.env.example

# Private keys, certificates, secrets, and auth tokens
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.token
*.secret
*credentials*.json
*token*.json
credentials.json
tunnel.json

# Cloudflare tunnel & local daemon secrets/configs
cloudflare/
cloudflare/*
cloudflared.log

# ============================================================
# 2. DOCKER LOCAL & SENSITIVE OVERRIDES
# ============================================================
# Local docker-compose overrides that may contain local secrets/ports
docker-compose.override.yml
docker-compose.override.yaml
docker-compose.local.yml
docker-compose.local.yaml
docker-compose*.env
*.env.docker
docker.env
.docker/

# ============================================================
# 3. BACKEND (Python / FastAPI / ML)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
.coverage
.coverage.*
htmlcov/
celerybeat-schedule
*.sqlite3
instance/

# Trained-model / heavy data artifacts
*.pkl
*.joblib
*.h5
*.onnx

# Allow core model json required by backend
!backend/app/ml/stargazing_xgb_model.json
!app/ml/stargazing_xgb_model.json

# Pipeline raw datasets & cache CSVs (prevents 100MB+ bloat in git)
backend/stargazing_pipeline/cache/
backend/stargazing_pipeline/cache_v3/
backend/stargazing_pipeline/*.csv
!backend/stargazing_pipeline/station_coordinates.csv

# ============================================================
# 4. FRONTEND (Next.js / Node)
# ============================================================
node_modules/
.next/
out/
build/
dist/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
.npm
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ============================================================
# 5. ARCHIVES & BACKUP ARTIFACTS
# ============================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.backup
*~
*.swp
*.swo

# ============================================================
# 6. OS & IDE NOISE
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
