# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your custom values
# ==============================================================================

# Public API URL (defaults to http://localhost:8000 for local runs)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Zero Trust Tunnel Token
# Obtain from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
